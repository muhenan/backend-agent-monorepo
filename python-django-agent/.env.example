# Copy this file to .env and add your API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Django development settings. Change these before any public deployment.
DJANGO_SECRET_KEY=replace-this-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL settings used when running Django directly on your computer.
DB_ENGINE=postgres
POSTGRES_DB=django_agent
POSTGRES_USER=django_agent
POSTGRES_PASSWORD=django_agent
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432

