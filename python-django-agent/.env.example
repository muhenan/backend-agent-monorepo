# Copy this file to .env and add your API key.
OPENAI_API_KEY=
# Set to https://api.deepseek.com when using DeepSeek; leave blank for OpenAI.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AGENTS_DISABLE_TRACING=

# Django development settings. Change these before any public deployment.
DJANGO_SECRET_KEY=replace-this-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL settings used when running Django directly on your computer.
DB_ENGINE=postgres
POSTGRES_DB=django_agent
POSTGRES_USER=django_agent
POSTGRES_PASSWORD=django_agent
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432

# Private local object storage. Compose uses http://minio:9000 internally.
S3_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=django-agent
MINIO_ROOT_PASSWORD=django-agent-local-password
S3_BUCKET=chat-attachments
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
